{
  "name": "tiai-frontend",
  "version": "0.1.0",
  "description": "Tia'i — console web de supervision",
  "productName": "Tiai",
  "author": "Natimai",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build -m spa",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "format": "prettier --write \"**/*.{ts,js,vue,json,scss,css,html,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,vue,json,scss,css,html,md}\"",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "axios": "^1.7.0",
    "pinia": "^4.1.0",
    "quasar": "^2.35.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@quasar/app-vite": "^3.10.3",
    "@quasar/vite-plugin": "^2.0.2",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^22.22.0 || ^24 || ^26"
  }
}
