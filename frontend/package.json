{
  "name": "tiai-frontend",
  "version": "0.1.0",
  "description": "Tia'i \u2014 console web de supervision",
  "productName": "Tiai",
  "author": "Natimai",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build -m spa",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"**/*.{ts,js,vue,json,scss,css,html,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,vue,json,scss,css,html,md}\"",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "axios": "^1.7.0",
    "pinia": "^4.0.3",
    "quasar": "^2.33.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.10.0",
    "@quasar/vite-plugin": "^2.0.2",
    "@types/node": "^22.20.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.22.0 || ^24 || ^26"
  }
}
