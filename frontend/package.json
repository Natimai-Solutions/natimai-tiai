{
  "name": "tiai-frontend",
  "version": "0.1.0",
  "description": "Tia'i — console web de supervision",
  "productName": "Tiai",
  "author": "Natimai",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build -m spa",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "format": "prettier --write \"**/*.{ts,js,vue,json,scss,css,html,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,vue,json,scss,css,html,md}\"",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "axios": "^1.21.1",
    "pinia": "^4.1.0",
    "qrcode-generator": "^2.0.4",
    "quasar": "^2.35.4",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.20",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@quasar/app-vite": "^3.10.4",
    "@quasar/vite-plugin": "^2.0.2",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^22.22.0 || ^24 || ^26"
  },
  "overrides": {
    "minimatch": "^11.0.8",
    "glob": "^14.0.6"
  }
}
