<?xml version="1.0" encoding="utf-8"?>
<!--
  Installateur MSI de l'agent Tia'i (WiX v4+).

  Construit par `wix build` (CI : .github/workflows/release.yml ; en local :
  deploy/msi/build.ps1) avec deux variables préprocesseur :

    -d ProductVersion=<x.y.z>   version MSI (numérique pure : un suffixe de
                                pré-version type `-dev.abc123` est refusé par
                                Windows Installer — le workflow le retire)
    -d AgentExe=<chemin>        binaire tiai-agent.exe à empaqueter (déjà
                                compilé avec la version injectée par ldflags)

  et `-arch x64` ou `-arch arm64` — un MSI par architecture, même UpgradeCode :
  deux paquets ne coexistent jamais sur un poste, l'un remplace l'autre.

  Ce que fait le paquet :
    - copie tiai-agent.exe dans %ProgramFiles%\Tiai ;
    - enregistre le service TiaiAgent (démarrage automatique, relance sur
      échec — mêmes réglages que `tiai-agent install`) et le démarre ;
    - écrit dans HKLM\SOFTWARE\Tiai les valeurs passées en propriétés
      (APIBASEURL, ENROLLMENTSECRET, …) — celles que l'agent lit déjà
      (agent/internal/config/registry_windows.go).

  Les valeurs registre sont marquées Permanent : une mise à jour ou une
  désinstallation ne les retire pas, donc un upgrade SANS repasser les
  propriétés conserve la configuration en place. %ProgramData%\Tiai (token
  DPAPI, logs) n'est pas touché non plus : un poste réinstallé garde son
  enrôlement.

  Le paquet verrouille aussi les deux emplacements sensibles (DACL réduite à
  SYSTEM + Administrateurs, SDDL avec SIDs universels — les mêmes que le script
  GPO) : HKLM\SOFTWARE\Tiai, où HKLM\SOFTWARE lisible par tout utilisateur
  authentifié exposerait le secret d'enrôlement, et %ProgramData%\Tiai, où les
  ACL héritées laisseraient token.dat lisible.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <?ifndef ProductVersion ?>
    <?define ProductVersion = "0.0.0" ?>
  <?endif?>
  <?ifndef AgentExe ?>
    <?define AgentExe = "..\..\dist\tiai-agent.exe" ?>
  <?endif?>

  <Package Name="Tia'i Agent"
           Manufacturer="Natimai Solutions"
           Version="$(var.ProductVersion)"
           UpgradeCode="023DE8A0-4D2C-49B3-9C8F-6DB0A55DDB00"
           Language="1033"
           InstallerVersion="500"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="Agent Tia'i — supervision du parc Windows" />

    <!-- AllowSameVersionUpgrades : les builds de dev partagent la version MSI
         0.0.0, il faut pouvoir les réinstaller l'un sur l'autre. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="Une version plus récente de l'agent Tia'i est déjà installée." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Natimai-Solutions/natimai-tiai" />

    <!-- Secure : requis pour qu'une propriété passée en ligne de commande
         traverse l'élévation (msiexec sous UAC, déploiement GPO).
         Hidden sur le secret : ne pas le laisser en clair dans les journaux
         MSI (msiexec /l*v). -->
    <Property Id="APIBASEURL" Secure="yes" />
    <Property Id="ENROLLMENTSECRET" Secure="yes" Hidden="yes" />
    <Property Id="LOGLEVEL" Secure="yes" />
    <Property Id="HEARTBEATINTERVALSECONDS" Secure="yes" />
    <Property Id="WUCOLLECTINTERVALSECONDS" Secure="yes" />
    <Property Id="WUINSTALLTIMEOUTSECONDS" Secure="yes" />
    <!-- 1 ou 0 (DWORD), pas true/false : voir ReportSessionUsername dans le
         README de l'agent — 0 = remonter la présence d'une session, pas le nom. -->
    <Property Id="REPORTSESSIONUSERNAME" Secure="yes" />
    <!-- Mêmes règles : 1 ou 0 en DWORD. 0 = inventaire matériel seul, la liste
         des logiciels installés n'est ni lue ni remontée (et celle déjà stockée
         côté serveur est effacée au prochain cycle). -->
    <Property Id="REPORTSOFTWARE" Secure="yes" />
    <Property Id="INVENTORYCOLLECTINTERVALSECONDS" Secure="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Tiai" />
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="TiaiDataFolder" Name="Tiai" />
    </StandardDirectory>

    <ComponentGroup Id="Agent" Directory="INSTALLFOLDER">

      <!-- Toujours installés, quelles que soient les propriétés fournies :
           ce sont eux qui verrouillent la clé et le dossier de données.
           Permanent : la désinstallation les laisse, comme le reste. -->
      <Component Id="RegKeyAcl" Guid="A052717E-3D53-421D-8F24-09F0017DA9D0"
                 Permanent="yes">
        <RegistryKey Root="HKLM" Key="SOFTWARE\Tiai" ForceCreateOnInstall="yes">
          <!-- KeyPath du composant (un composant registre s'ancre sur une
               valeur) ; versionnée pour pouvoir faire évoluer la DACL un jour. -->
          <RegistryValue Name="AclVersion" Type="integer" Value="1" KeyPath="yes" />
          <PermissionEx Sddl="D:P(A;CI;KA;;;SY)(A;CI;KA;;;BA)" />
        </RegistryKey>
      </Component>

      <Component Id="DataDirAcl" Guid="8F66442E-F618-4EB2-8B93-BEE247FFE645"
                 Permanent="yes" Directory="TiaiDataFolder">
        <CreateFolder>
          <PermissionEx Sddl="D:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" />
        </CreateFolder>
      </Component>

      <Component Id="AgentExe" Guid="BC1E88C9-9E8F-4EF6-80BD-766167DE3A60">
        <File Id="AgentExeFile" Name="tiai-agent.exe" Source="$(var.AgentExe)" KeyPath="yes" />

        <!-- `run` sans chemin de config : l'agent retombe sur son défaut
             (%ProgramData%\Tiai\config.yaml, facultatif) + le registre —
             exactement ce que `tiai-agent install` enregistre. -->
        <ServiceInstall Id="AgentService"
                        Name="TiaiAgent"
                        DisplayName="Tiai Agent"
                        Description="Reports Microsoft Defender state to the Tiai server and executes its commands."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Arguments="run">
          <!-- Relance sur échec, remise à zéro du compteur après 24 h — les
               réglages de service.Install (service_windows.go).

               La troisième action est une relance et non "none", et c'est tout
               l'objet du réglage : le SCM répète la dernière action pour chaque
               panne suivante, donc "relance, relance, rien" laissait un poste
               tombé trois fois dans la journée avec un service arrêté, un type
               de démarrage toujours affiché en Automatique, et rien à l'écran
               pour le dire. -->
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="15"
                              ResetPeriodInDays="1" />
        </ServiceInstall>

        <!-- Deux éléments, car Wait diffère : l'arrêt doit être attendu (le
             fichier est verrouillé tant que le processus vit), mais pas le
             démarrage — sans ApiBaseURL (posé plus tard par GPO, par exemple)
             l'agent sort aussitôt, et l'installation ne doit pas échouer pour
             autant : le service repartira au prochain démarrage du poste. -->
        <ServiceControl Id="AgentServiceStop" Name="TiaiAgent" Stop="both" Remove="uninstall" Wait="yes" />
        <ServiceControl Id="AgentServiceStart" Name="TiaiAgent" Start="install" Wait="no" />
      </Component>

      <!-- Un composant par valeur registre : chacun n'est installé que si sa
           propriété est fournie, et Permanent les laisse en place à la
           désinstallation comme au passage de version. -->
      <Component Id="RegApiBaseUrl" Guid="3123C131-7FC9-46DF-8706-B86CDAFF3C60"
                 Permanent="yes" Condition="APIBASEURL">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Tiai" Name="ApiBaseURL"
                       Type="string" Value="[APIBASEURL]" KeyPath="yes" />
      </Component>

      <Component Id="RegEnrollmentSecret" Guid="9A9FEB38-7EC3-41B3-A82A-B8B2D2C02E8E"
                 Permanent="yes" Condition="ENROLLMENTSECRET">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Tiai" Name="EnrollmentSecret"
                       Type="string" Value="[ENROLLMENTSECRET]" KeyPath="yes" />
      </Component>

      <Component Id="RegLogLevel" Guid="05233ECA-926C-40A1-9E0F-8E026D890E2A"
                 Permanent="yes" Condition="LOGLEVEL">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Tiai" Name="LogLevel"
                       Type="string" Value="[LOGLEVEL]" KeyPath="yes" />
      </Component>

      <Component Id="RegHeartbeatInterval" Guid="BDB675B2-F873-4793-8824-BBE07C3318F5"
                 Permanent="yes" Condition="HEARTBEATINTERVALSECONDS">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Tiai" Name="HeartbeatIntervalSeconds"
                       Type="integer" Value="[HEARTBEATINTERVALSECONDS]" KeyPath="yes" />
      </Component>

      <Component Id="RegWUCollectInterval" Guid="D2990227-8702-4783-B893-59016B4C24D0"
                 Permanent="yes" Condition="WUCOLLECTINTERVALSECONDS">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Tiai" Name="WUCollectIntervalSeconds"
                       Type="integer" Value="[WUCOLLECTINTERVALSECONDS]" KeyPath="yes" />
      </Component>

      <Component Id="RegWUInstallTimeout" Guid="20A5C020-1863-43FE-B050-359FD318D787"
                 Permanent="yes" Condition="WUINSTALLTIMEOUTSECONDS">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Tiai" Name="WUInstallTimeoutSeconds"
                       Type="integer" Value="[WUINSTALLTIMEOUTSECONDS]" KeyPath="yes" />
      </Component>

      <Component Id="RegReportSessionUsername" Guid="E5824CAE-D846-44F9-8E9E-8CB45BB6E7C9"
                 Permanent="yes" Condition="REPORTSESSIONUSERNAME">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Tiai" Name="ReportSessionUsername"
                       Type="integer" Value="[REPORTSESSIONUSERNAME]" KeyPath="yes" />
      </Component>

      <Component Id="RegReportSoftware" Guid="7C0D3E38-1A5B-4C9E-9E4B-2E2C4F6B1D77"
                 Permanent="yes" Condition="REPORTSOFTWARE">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Tiai" Name="ReportSoftware"
                       Type="integer" Value="[REPORTSOFTWARE]" KeyPath="yes" />
      </Component>

      <Component Id="RegInventoryCollectInterval" Guid="1B7F5A64-9D02-4F35-8C77-30B6A9D6C412"
                 Permanent="yes" Condition="INVENTORYCOLLECTINTERVALSECONDS">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Tiai" Name="InventoryCollectIntervalSeconds"
                       Type="integer" Value="[INVENTORYCOLLECTINTERVALSECONDS]" KeyPath="yes" />
      </Component>

    </ComponentGroup>

    <Feature Id="Main" Title="Agent Tia'i">
      <ComponentGroupRef Id="Agent" />
    </Feature>

  </Package>
</Wix>
