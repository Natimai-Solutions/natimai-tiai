# Copie en .env et renseigne les valeurs. Ne JAMAIS committer .env.
#
# Les 4 valeurs marquées « changeme » doivent être générées aléatoirement
# (32 octets hex) — le backend refuse de démarrer hors ENVIRONMENT=local tant
# qu'elles portent ce préfixe. Commandes Windows/Linux : cf. ../DEPLOYMENT.md
# § « Générer les secrets ».
#   Linux/macOS : openssl rand -hex 32

# --- Nom du serveur (doit correspondre au CN/SAN du certificat AC interne) ---
TIAI_SERVER_NAME=tiai.natimai.local

# --- PostgreSQL ---
POSTGRES_USER=tiai
POSTGRES_PASSWORD=changeme-strong-password
POSTGRES_DB=tiai

# --- Backend ---
ENVIRONMENT=production
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
# Premier compte admin, créé au démarrage s'il n'existe pas encore.
FIRST_ADMIN_EMAIL=admin@natimai.solutions
FIRST_ADMIN_PASSWORD=changeme-strong-admin-password
# Secret d'enrôlement partagé (déployé par GPO côté agents). Ne sert qu'à /enroll.
ENROLLMENT_SECRET=changeme-shared-enrollment-secret
# Origines CORS autorisées pour la console (séparées par des virgules).
BACKEND_CORS_ORIGINS=https://tiai.natimai.local
# URL publique de la console, utilisée pour construire le lien de
# réinitialisation de mot de passe envoyé par e-mail. Sans elle, le parcours
# « mot de passe oublié » n'envoie rien (la réinitialisation par un admin, elle,
# continue de fonctionner).
CONSOLE_BASE_URL=https://tiai.natimai.local
# Longueur minimale des mots de passe acceptés par l'API (défaut : 12).
#PASSWORD_MIN_LENGTH=12
# Durée de validité d'un lien de réinitialisation, en minutes (défaut : 60).
#PASSWORD_RESET_EXPIRE_MINUTES=60

# --- Réveil des postes (Wake-on-LAN) ---
# Le paquet magique est émis par le SERVEUR (le poste visé est éteint), vers
# l'adresse de diffusion du sous-réseau du poste, déduite de sa dernière IP
# connue. Prérequis poste / réseau / hôte Docker : cf. ../DEPLOYMENT.md
# § « Réveil des postes (Wake-on-LAN) » — sans le réglage sysctl qui y est
# décrit, un backend en conteneur émet dans le vide.
# Masque de REPLI (192.168.1.42 -> 192.168.1.255). Le masque vient normalement
# du poste lui-même, remonté par son agent avec l'adresse : celui-ci ne sert
# qu'aux agents trop anciens pour le remonter.
#WOL_SUBNET_PREFIXLEN=24
# Adresses de diffusion explicites (virgules). Renseignées, elles REMPLACENT
# l'adresse déduite et servent pour tous les postes.
#WOL_BROADCAST_ADDRESSES=
# Port UDP du paquet (indifférent au matériel) et nombre de copies émises.
#WOL_PORT=9
#WOL_PACKET_COUNT=3

# --- Envoi d'e-mails (Mailgun) ---
# Un compte se crée facilement sur https://www.mailgun.com — le domaine d'envoi
# et la clé API sont ensuite dans son tableau de bord.
# Ces réglages disent comment le courrier part, jamais à qui : les destinataires
# sont les comptes de la console, chacun avec sa cadence (page « Mon compte »).
MAILGUN_API_BASE_URL=https://api.mailgun.net/v3
MAILGUN_DOMAIN=
MAILGUN_API_KEY=
MAILGUN_FROM_EMAIL=tiai@natimai.solutions
MAILGUN_FROM_NAME=Tiai
# Proxy HTTP sortant pour le seul client Mailgun (ex. http://10.0.0.1:3128),
# utile derrière le proxy d'un établissement. Volontairement distinct de
# HTTP_PROXY/HTTPS_PROXY, que tous les processus honoreraient — Caddy compris,
# qui doit continuer à joindre backend et frontend en direct.
#MAILGUN_PROXY_URL=

# --- Cadence des notifications ---
# Heure UTC d'envoi du résumé quotidien. Le parc visé est à UTC-10, où 18:00 UTC
# correspond à 08:00 sur place ; à ajuster selon le fuseau du déploiement.
#DIGEST_HOUR_UTC=18
# Une détection plus ancienne que cela ne déclenche jamais d'alerte immédiate :
# un poste qui s'enrôle remonte tout l'historique Defender en un seul appel.
#THREAT_ALERT_MAX_AGE_HOURS=24
# Nombre de postes détaillés dans un e-mail avant « … et N autres ».
#NOTIFICATION_MAX_ITEMS=10
