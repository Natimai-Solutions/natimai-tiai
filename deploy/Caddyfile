# Caddy — reverse-proxy + terminaison TLS pour Tiai.
#
# Le certificat serveur est émis par l'AC interne (AD CS) pour le nom du
# serveur. Les postes du domaine font déjà confiance à cette AC racine.
# Place le certificat et sa clé dans deploy/certs/ (montés en lecture seule).
#
# Sans certificat fourni (dev / tests), remplace la ligne `tls` par :
#     tls internal
# → Caddy génère un certificat local auto-signé, aucune dépendance à un certif.
# (Pour des tests en HTTP pur, on peut aussi viser directement le backend:8000
#  sans passer par Caddy — cf. §2.12 : le TLS n'est pas une dépendance dure.)

# Un nom canonique, et des alias facultatifs (TIAI_SERVER_ALIASES, séparés par
# des espaces : « tiai 10.0.0.5 »). Un alias n'est servi qu'en redirection vers
# le nom canonique : la console garde la session dans le stockage du
# navigateur, qui est propre à chaque origine — deux noms feraient deux
# sessions. En HTTPS, le certificat doit porter l'alias dans ses SAN.
{$TIAI_SERVER_NAME:tiai.natimai.local} {$TIAI_SERVER_ALIASES} {
	tls /etc/caddy/certs/tiai.crt /etc/caddy/certs/tiai.key

	# En-têtes de sécurité — posés ici (seul point d'exposition) plutôt que
	# dans nginx : `header` écrase toute valeur amont, source de vérité unique.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# CSP pour la SPA Quasar : scripts/styles servis par le build (self) ;
		# 'unsafe-inline' requis pour les styles inline posés par Quasar/Vue.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Un alias (ou un hôte autre que le nom canonique) est renvoyé vers le nom
	# canonique, même chemin.
	@alias not host {$TIAI_SERVER_NAME:tiai.natimai.local}
	redir @alias https://{$TIAI_SERVER_NAME:tiai.natimai.local}{uri} permanent

	# `network_proxy none` sur chaque upstream : un hôte Docker configuré pour
	# un proxy (~/.docker/config.json, « proxies ») injecte HTTP_PROXY et
	# HTTPS_PROXY dans tous les conteneurs, et Caddy les honorerait pour
	# joindre backend et frontend — le proxy de l'établissement recevrait alors
	# « GET http://backend:8000/… » et répondrait par son portail, en boucle
	# de redirections. Ces deux upstreams sont sur le réseau Compose : jamais
	# de proxy, quoi que dise l'environnement.
	# API backend
	handle /api/* {
		# Plafond de taille d'une requête, refusée en 413 avant d'atteindre le
		# backend. Le plus gros envoi légitime est le heartbeat qui porte
		# l'inventaire complet d'un poste (quelques centaines de Kio) ; 8 Mo
		# laissent une marge d'un ordre de grandeur sans laisser un agent
		# défaillant ou hostile pousser des centaines de Mo dans l'API.
		request_body {
			max_size 8MB
		}
		reverse_proxy backend:8000 {
			transport http {
				network_proxy none
			}
		}
	}

	handle /health {
		reverse_proxy backend:8000 {
			transport http {
				network_proxy none
			}
		}
	}

	# Console (build Quasar servi par nginx)
	handle {
		reverse_proxy frontend:80 {
			transport http {
				network_proxy none
			}
		}
	}

	encode gzip
}

# Tout ce qui arrive en HTTP sous un autre nom — « tiai » tapé dans la barre
# d'adresse, l'adresse IP — est renvoyé vers la console, sans certificat à
# présenter puisque la réponse part en clair. Le nom canonique lui-même est
# déjà redirigé par Caddy (HTTPS automatique).
http:// {
	redir https://{$TIAI_SERVER_NAME:tiai.natimai.local}{uri} permanent
}
